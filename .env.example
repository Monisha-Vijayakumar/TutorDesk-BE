# Copy to .env and fill in real values. Never commit .env.
NODE_ENV=development
PORT=5000

# Local: `npm run db:local` starts a MongoDB on this address. Production: your MongoDB Atlas URI.
MONGODB_URI=mongodb://127.0.0.1:27017/tutordesk

# Long random string (e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`)
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_EXPIRES_IN=7d

# The FE origin allowed by CORS (the Vercel URL in production)
CLIENT_URL=http://localhost:5173

APP_TIMEZONE=Asia/Kolkata

# Seeder only (`npm run seed`) — the single admin account. Placeholders; use your own values.
ADMIN_NAME=Admin Name
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Change@Me123
ADMIN_PHONE=+919876543210
ADMIN_ADDRESS=12 Example Street
ADMIN_CENTER_NAME=Example Tuition Center
ADMIN_CITY=Chennai
ADMIN_STATE=Tamil Nadu
ADMIN_BRANCH=
FEE_DUE_DAY=10
STUDENT_CODE_START=100000001
