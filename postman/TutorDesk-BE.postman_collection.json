              "mode": "raw",
              "raw": "{\n  \"totalFee\": 200000,\n  \"dueDate\": \"{{today}}\",\n  \"payment\": null\n}"
            },
            "url": "{{baseUrl}}/fees/{{feeId}}"
          }
        },
        {
          "name": "Edit fee + record a payment",
          "description": "Amounts are paise (₹500 = 50000). Each payment is stored as its own record.",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"totalFee\": 200000,\n  \"dueDate\": \"{{today}}\",\n  \"payment\": {\n    \"amount\": 50000,\n    \"paidOn\": \"{{today}}\",\n    \"method\": \"UPI\"\n  }\n}"
            },
            "url": "{{baseUrl}}/fees/{{feeId}}"
          }
        },
        {
          "name": "Record payment reminder (WhatsApp)",
          "description": "Records the initiation only (status INITIATED). 409 once nothing is outstanding.",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('201', () => pm.response.to.have.status(201));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"channel\": \"WHATSAPP\",\n  \"type\": \"MANUAL\",\n  \"contact\": \"+919840012345\"\n}"
            },
            "url": "{{baseUrl}}/fees/{{feeId}}/reminders"
          }
        }
      ]
    },
