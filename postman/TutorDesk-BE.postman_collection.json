{
  "info": {
    "name": "TutorDesk BE",
    "description": "Every TutorDesk API endpoint (REQUIREMENTS §7) plus the main error cases.\n\nSetup: import this collection and `TutorDesk-Local.postman_environment.json`, pick the \"TutorDesk Local\" environment, start the API (`npm run db:local`, `npm run seed`, optionally `npm run seed:demo`, `npm run dev`).\n\nAuth is the httpOnly cookie `tutordesk_token`: run **Auth → Login (admin)** first — Postman keeps the cookie for localhost and sends it with every request. **Auth → Logout** clears it.\n\nIds are saved automatically: Create student → `studentId`, List fees → `feeId`, Create batch → `batchId`. `today` and `currentMonth` are set in IST before each request.\n\nRun the folders top to bottom (or use the Collection Runner) — each request checks its expected status code.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// \"today\" and \"this month\" in the center's timezone (Asia/Kolkata, UTC+5:30), like the API.",
          "const indiaNow = new Date(Date.now() + 330 * 60 * 1000).toISOString();",
          "pm.collectionVariables.set('today', indiaNow.slice(0, 10));",
          "pm.collectionVariables.set('currentMonth', indiaNow.slice(0, 7));"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "today",
      "value": ""
    },
    {
      "key": "currentMonth",
      "value": ""
    },
    {
      "key": "studentId",
      "value": ""
    },
    {
      "key": "studentCode",
      "value": ""
    },
    {
      "key": "feeId",
      "value": ""
    },
    {
      "key": "batchId",
      "value": ""
    },
    {
      "key": "newAdminPassword",
      "value": ""
    },
    {
      "key": "studentPassword",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health check",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 ok', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/health"
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login (admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 + user', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().user.role).to.eql('ADMIN');",
                  "});",
                  "pm.test('sets the httpOnly cookie', () => pm.expect(pm.cookies.has('tutordesk_token')).to.be.true);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identifier\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
            },
            "url": "{{baseUrl}}/auth/login"
          }
        },
        {
          "name": "Current user (me)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/auth/me"
          }
        },
        {
          "name": "Update profile",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Admin Name\",\n  \"phone\": \"+91 98765 43210\",\n  \"address\": \"12 Example Street\",\n  \"centerName\": \"Example Tuition Center\",\n  \"branch\": null,\n  \"city\": \"Chennai\",\n  \"state\": \"Tamil Nadu\",\n  \"feeDueDay\": 10\n}"
            },
            "url": "{{baseUrl}}/auth/profile"
          }
        },
        {
          "name": "Change password",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"204\", () => pm.response.to.have.status(204));",
                  "// Keep the environment in sync so Login keeps working.",
                  "if (pm.response.code === 204) { pm.environment.set(\"adminPassword\", pm.collectionVariables.get(\"newAdminPassword\")); }"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const current = pm.environment.get(\"adminPassword\");",
                  "pm.collectionVariables.set(\"newAdminPassword\", current === \"Tutor@2026\" ? \"Change@Me123\" : \"Tutor@2026\");"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currentPassword\": \"{{adminPassword}}\",\n  \"newPassword\": \"{{newAdminPassword}}\"\n}"
            },
            "url": "{{baseUrl}}/auth/change-password"
          }
        },
        {
          "name": "Logout",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('204', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/logout"
          }
        }
      ]
    },
    {
      "name": "Students",
      "item": [
        {
          "name": "Create student",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('201', () => pm.response.to.have.status(201));",
                  "const { student } = pm.response.json();",
                  "if (student) {",
                  "  pm.collectionVariables.set('studentId', student.id);",
                  "  pm.collectionVariables.set('studentCode', student.studentCode);",
                  "}",
                  "pm.collectionVariables.set(\"studentPassword\", \"Student@123\");"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Kavya\",\n  \"lastName\": \"Raman\",\n  \"email\": null,\n  \"phone\": \"\",\n  \"parentName\": \"Suresh Raman\",\n  \"parentPhone\": \"+91 98400 12345\",\n  \"grade\": \"Class 8\",\n  \"subjects\": [\"Mathematics\", \"English\"],\n  \"monthlyFee\": 200000,\n  \"joinDate\": \"{{today}}\",\n  \"password\": \"Student@123\"\n}"
            },
            "url": "{{baseUrl}}/students"
          }
        },
        {
          "name": "List students",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/students?page=1&limit=10"
          }
        },
        {
          "name": "List students (search + filters)",
          "description": "search: Student ID or name. paymentStatus: PAID | PENDING | OVERDUE | PARTIAL (this month). paidFrom / paidTo: YYYY-MM-DD. Disable the params you don't need — empty params are never sent by the FE.",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/students?search=kav&paymentStatus=PENDING&paidFrom={{currentMonth}}-01&paidTo={{today}}&page=1&limit=20",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "students"
              ],
              "query": [
                {
                  "key": "search",
                  "value": "kav"
                },
                {
                  "key": "paymentStatus",
                  "value": "PENDING"
                },
                {
                  "key": "paidFrom",
                  "value": "{{currentMonth}}-01",
                  "disabled": true
                },
                {
                  "key": "paidTo",
                  "value": "{{today}}",
                  "disabled": true
                },
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "20"
                }
              ]
            }
          }
        },
        {
          "name": "Get student",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/students/{{studentId}}"
          }
        },
        {
          "name": "Update student",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Kavya\",\n  \"lastName\": \"Raman\",\n  \"email\": \"kavya.raman@example.com\",\n  \"phone\": \"98400 54321\",\n  \"parentName\": \"Suresh Raman\",\n  \"parentPhone\": \"+91 98400 12345\",\n  \"grade\": \"Class 9\",\n  \"subjects\": [\"Mathematics\", \"English\", \"Science\"],\n  \"monthlyFee\": 250000,\n  \"joinDate\": \"{{today}}\"\n}"
            },
            "url": "{{baseUrl}}/students/{{studentId}}"
          }
        },
        {
          "name": "Payment history",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/students/{{studentId}}/payment-history"
          }
        },
        {
          "name": "Reset student password",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const { temporaryPassword } = pm.response.json();",
                  "if (temporaryPassword) { pm.collectionVariables.set(\"studentPassword\", temporaryPassword); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/students/{{studentId}}/reset-password"
          }
        }
      ]
