    {
      "name": "Fees",
      "item": [
        {
          "name": "List fees (month)",
          "description": "Saves the first row's id as feeId. Pick another month (≤ current) to see older months.",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const [firstFee] = pm.response.json().fees || [];",
                  "if (firstFee) { pm.collectionVariables.set('feeId', firstFee.id); }"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
